# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-anon-key"
NUXT_SUPABASE_SECRET_KEY="your-service-role-key"

# ─── Stripe (Live) ────────────────────────────────────────────────────────────
NUXT_STRIPE_SECRET_KEY="sk_live_..."
NUXT_STRIPE_WEBHOOK_SECRET="whsec_..."
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ─── Stripe (Test) ───────────────────────────────────────────────────────────
NUXT_STRIPE_TEST_SECRET_KEY="sk_test_..."
NUXT_STRIPE_TEST_WEBHOOK_SECRET="whsec_test_..."
NUXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY="pk_test_..."

# Set to 'true' to use test keys; 'false' or empty for live
NUXT_STRIPE_TEST_MODE="true"
NUXT_PUBLIC_STRIPE_TEST_MODE="true"

# ─── Email — Resend (preferred) ───────────────────────────────────────────────
NUXT_RESEND_API_KEY="re_..."

# ─── Email — Zoho SMTP (fallback if Resend key is absent) ────────────────────
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_USER="info@trainingyarddsm.com"
SMTP_PASS="your-zoho-app-password"

# ─── Admin Config ─────────────────────────────────────────────────────────────
NUXT_ADMIN_EMAIL="adam@heartlandroofingandsiding.com,jesse@heartlandroofingandsiding.com"

# ─── Cron Security ────────────────────────────────────────────────────────────
# Shared secret for the /api/cron/reminders endpoint
NUXT_CRON_SECRET="change-this-to-a-random-secret"

# ─── Public App ───────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL="https://trainingyarddsm.com"

# ─── Zoho Sign (optional — waiver embed) ─────────────────────────────────────
# NUXT_PUBLIC_ZOHO_SIGN_URL="https://sign.zoho.com/signform?..."
